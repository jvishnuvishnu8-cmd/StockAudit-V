function pgInventory() {
  const low = lowStkItems();
  const rows = PRODUCTS.map(p=>{
    const sizes = ['100ml','200ml','500ml','1L'];
    const cells = sizes.map(sz=>`<td class="tac">${stkBadge(p.stock[sz]||0,p.alert)}</td>`).join('');
    const tot   = Object.values(p.stock).reduce((a,b)=>a+b,0);
    return `<tr>
      <td><div class="fr"><span style="font-size:22px">${p.emoji}</span><div><div class="bold">${p.name}</div><div class="muted" style="font-size:11px">Alert: ≤${p.alert} units</div></div></div></td>
      ${cells}
      <td class="tac bold">${tot}</td>
      <td><div class="fr">
        ${ROLE==='admin'?`<button class="btn btn-primary btn-xs" onclick="adjustStock('${p.id}')">Adjust</button>`:''}
        ${ROLE==='admin'?`<button class="btn btn-red btn-xs" onclick="delProduct('${p.id}')">🗑️</button>`:''}
      </div></td></tr>`;
  }).join('');
  const alert = low.length
    ? `<div class="alert alert-warn">⚠️ <b>${low.length} low stock alert${low.length>1?'s':''}</b> — Take action below</div>`
    : `<div class="alert alert-ok">✅ All stock levels are healthy</div>`;
  return `
  ${alert}
  <div class="card">
    <div class="card-hd">
      <div class="card-title">📦 Stock Levels</div>
      ${ROLE==='admin'?`<div class="fr"><button class="btn btn-primary btn-sm" onclick="addProductModal()">+ Add Product</button><button class="btn btn-green btn-sm" onclick="bulkRestockModal()">📥 Bulk Restock</button></div>`:''}
    </div>
    <div class="tbl-wrap"><table>
      <thead><tr><th>Product</th><th class="tac">100ml</th><th class="tac">200ml</th><th class="tac">500ml</th><th class="tac">1L</th><th class="tac">Total</th><th>Actions</th></tr></thead>
      <tbody>${rows}</tbody>
    </table></div>
  </div>`;
}
function adjustStock(pid) {
  const p = byPid(pid); if(!p) return;
  const opts = ['100ml','200ml','500ml','1L'].map(s=>`<option>${s}</option>`).join('');
  modal(`📦 Adjust Stock — ${p.name}`,`
    <div class="form-grid">
      ${fg('Size',`<select id="as_sz">${opts}</select>`)}
      ${fg('Action','<select id="as_a"><option value="add">Add (+)</option><option value="sub">Remove (−)</option><option value="set">Set Exact</option></select>')}
    </div>
    ${fg('Quantity','<input id="as_q" type="number" value="0" min="0">')}`,
    `<button class="btn btn-ghost" onclick="closeModal()">Cancel</button><button class="btn btn-primary" onclick="saveAdj('${pid}')">Update</button>`
  );
}
function saveAdj(pid) {
  const p   = byPid(pid); if(!p) return;
  const sz  = document.getElementById('as_sz').value;
  const act = document.getElementById('as_a').value;
  const q   = parseInt(document.getElementById('as_q').value)||0;
  if (act==='add') p.stock[sz]=(p.stock[sz]||0)+q;
  else if(act==='sub') p.stock[sz]=Math.max(0,(p.stock[sz]||0)-q);
  else p.stock[sz]=q;
  save(); closeModal(); go('inventory'); toast('Stock updated','ok');
}
function addProductModal() {
  modal('➕ New Product',`
    <div class="form-grid">${fg('Name','<input id="np_n" placeholder="Product name">')}${fg('Emoji','<input id="np_e" value="🫙" maxlength="2">')}</div>
    ${fg('Description','<input id="np_d" placeholder="Short description">')}
    <div class="section-lbl">Pricing (₹)</div>
    <div class="form-grid g3">${fg('100ml','<input id="np_p1" type="number" value="0">')}${fg('200ml','<input id="np_p2" type="number" value="0">')}${fg('500ml','<input id="np_p5" type="number" value="0">')}${fg('1L','<input id="np_p10" type="number" value="0">')}</div>
    <div class="section-lbl">Initial Stock</div>
    <div class="form-grid g3">${fg('100ml','<input id="np_s1" type="number" value="0">')}${fg('200ml','<input id="np_s2" type="number" value="0">')}${fg('500ml','<input id="np_s5" type="number" value="0">')}${fg('1L','<input id="np_s10" type="number" value="0">')}</div>
    ${fg('Low Alert Level','<input id="np_a" type="number" value="20">')}`,
    `<button class="btn btn-ghost" onclick="closeModal()">Cancel</button><button class="btn btn-primary" onclick="saveProduct()">✅ Add</button>`,'lg'
  );
}
function saveProduct() {
  const n = document.getElementById('np_n').value.trim();
  if(!n){ toast('Name required','err'); return; }
  PRODUCTS.push({
    id:'p'+Date.now(), name:n, emoji:document.getElementById('np_e').value||'🫙',
    desc:document.getElementById('np_d').value,
    sizes:{'100ml':+document.getElementById('np_p1').value,'200ml':+document.getElementById('np_p2').value,'500ml':+document.getElementById('np_p5').value,'1L':+document.getElementById('np_p10').value},
    stock:{'100ml':+document.getElementById('np_s1').value,'200ml':+document.getElementById('np_s2').value,'500ml':+document.getElementById('np_s5').value,'1L':+document.getElementById('np_s10').value},
    alert:parseInt(document.getElementById('np_a').value)||20
  });
  save(); closeModal(); go('inventory'); toast('Product added!','ok');
}
function delProduct(pid) {
  if(!confirm('Delete this product?')) return;
  PRODUCTS = PRODUCTS.filter(p=>p.id!==pid);
  save(); go('inventory'); toast('Product removed','warn');
}
function bulkRestockModal() {
  const rows = PRODUCTS.map(p=>`<tr><td>${p.emoji} <b>${p.name}</b></td>`
    +['100ml','200ml','500ml','1L'].map(sz=>`<td><input type="number" value="${p.stock[sz]||0}" min="0" style="width:65px;padding:4px 6px;border:1px solid var(--cream3);border-radius:6px;text-align:center;font-family:var(--mono)" data-pid="${p.id}" data-sz="${sz}"></td>`).join('')+'</tr>').join('');
  modal('📥 Bulk Stock Update',`<div class="tbl-wrap"><table><thead><tr><th>Product</th><th>100ml</th><th>200ml</th><th>500ml</th><th>1L</th></tr></thead><tbody>${rows}</tbody></table></div>`,
    `<button class="btn btn-ghost" onclick="closeModal()">Cancel</button><button class="btn btn-primary" onclick="saveBulk()">💾 Update All</button>`,'lg'
  );
}
function saveBulk() {
  document.querySelectorAll('#mBody input[data-pid]').forEach(inp=>{ const p=byPid(inp.dataset.pid); if(p) p.stock[inp.dataset.sz]=parseInt(inp.value)||0; });
  save(); closeModal(); go('inventory'); toast('All stock updated','ok');
}

