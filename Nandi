//  SETTINGS
// ══════════════════════════════════════════════
function pgSettings() {
  return `
  <div class="card"><div class="card-hd"><div class="card-title">⚙️ Company Information</div></div><div class="card-bd">
    <div class="form-grid">${fg('Company Name',`<input id="sc_n" value="${COMPANY.name}">`)}${fg('Tagline',`<input id="sc_t" value="${COMPANY.tag}">`)}</div>
    ${fg('Address',`<textarea id="sc_a">${COMPANY.addr}</textarea>`)}
    <div class="form-grid">${fg('Phone',`<input id="sc_ph" value="${COMPANY.ph}">`)}${fg('Email',`<input id="sc_e" value="${COMPANY.email}">`)}</div>
    ${fg('GST Number',`<input id="sc_g" value="${COMPANY.gst}">`)}
    <button class="btn btn-primary" onclick="saveSettings()">💾 Save Changes</button>
  </div></div>

  <div class="card"><div class="card-hd"><div class="card-title">🔐 Change Password</div></div><div class="card-bd">
    ${fg('Current Password','<input id="cp_o" type="password">')}
    ${fg('New Password','<input id="cp_n" type="password">')}
    ${fg('Confirm New Password','<input id="cp_c" type="password">')}
    <button class="btn btn-primary" onclick="changePass()">🔐 Update Password</button>
  </div></div>

  <div class="card"><div class="card-hd"><div class="card-title">🔥 Firebase Configuration</div></div><div class="card-bd">
    <div class="alert alert-warn">⚠️ Edit the FB_CFG object at the top of the HTML file to connect your Firebase project. Once connected, all data syncs in real-time across devices.</div>
    <pre style="background:var(--cream2);padding:1rem;border-radius:8px;font-family:var(--mono);font-size:11.5px;overflow-x:auto;line-height:1.7">const FB_CFG = {
  apiKey:            "YOUR_API_KEY",
  authDomain:        "YOUR_PROJECT.firebaseapp.com",
  databaseURL:       "https://YOUR_PROJECT-default-rtdb.firebaseio.com",
  projectId:         "YOUR_PROJECT_ID",
  storageBucket:     "YOUR_PROJECT.appspot.com",
  messagingSenderId: "YOUR_SENDER_ID",
  appId:             "YOUR_APP_ID"
};</pre>
    <div style="font-size:12px;color:var(--brown3);margin-top:.5rem">Get this from: <b>console.firebase.google.com → Project Settings → Your Apps → Web App → Config</b></div>
  </div></div>`;
}
function saveSettings() {
  COMPANY.name=document.getElementById('sc_n').value; COMPANY.tag=document.getElementById('sc_t').value;
  COMPANY.addr=document.getElementById('sc_a').value; COMPANY.ph=document.getElementById('sc_ph').value;
  COMPANY.email=document.getElementById('sc_e').value; COMPANY.gst=document.getElementById('sc_g').value;
  save(); toast('Settings saved!','ok');
}
function changePass() {
  const o=document.getElementById('cp_o').value, n=document.getElementById('cp_n').value, c=document.getElementById('cp_c').value;
  if (!CU) return;
  const k = Object.keys(CREDS).find(k=>CREDS[k].email===CU.email);
  if (!k||CREDS[k].pass!==o) { toast('Current password incorrect','err'); return; }
  if (n!==c) { toast('New passwords do not match','err'); return; }
  if (n.length<6) { toast('Minimum 6 characters','err'); return; }
  CREDS[k].pass=n; toast('Password updated!','ok');
}

// ══════════════════════════════════════════════
//  BOOT
// ══════════════════════════════════════════════
(function boot() {
  initFB();
  load();
  // Clock
  const c = document.getElementById('topDate');
  if(c) c.textContent = new Date().toLocaleDateString('en-IN',{weekday:'short',day:'2-digit',month:'short',year:'numeric'});
  // Auto-restore session
  try {
    const s = localStorage.getItem('nandi_cu');
    if (s) {
      const cu = JSON.parse(s);
      const found = Object.values(CREDS).find(x=>x.email===cu.email&&x.role===cu.role);
      if (found) {
        CU=found; ROLE=found.role;
        document.getElementById('loginWrap').style.display='none';
        document.getElementById('appWrap').style.display='block';
        document.getElementById('sbAv').textContent=found.name[0];
        document.getElementById('sbName').textContent=found.name;
        document.getElementById('sbRole').textContent=found.role==='admin'?'Administrator':'Employee';
        document.getElementById('sbSub').textContent=found.role==='admin'?'Admin Panel':'Employee Panel';
        buildNav(); go('dashboard'); updateClock(); return;
      }
    }
  } catch(e) { localStorage.removeItem('nandi_cu'); }
  setRole('admin');
})();
</script>

