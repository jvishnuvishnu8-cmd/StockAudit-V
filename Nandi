function pgOrders(f='', tf='', sf='') {
  const list = ORDERS.filter(o=>{
    if (f  && !o.cust.toLowerCase().includes(f.toLowerCase()) && !o.id.toLowerCase().includes(f.toLowerCase()) && !o.ph.includes(f)) return false;
    if (tf && o.type!==tf) return false;
    if (sf && o.status!==sf) return false;
    return true;
  });

  const sCounts = { Pending:0, Processing:0, Packed:0, Delivered:0 };
  ORDERS.forEach(o=>{ if(sCounts[o.status]!==undefined) sCounts[o.status]++; });

  const rows = list.map(o=>{
    const pr  = byPid(o.pid);
    const waMsg = encodeURIComponent(`Hi ${o.cust}, your Nandi Oils order #${o.id} (${pr?pr.name:'?'} ${o.sz} ×${o.qty}) is now *${o.status}*. Total: ${fmtC(o.total)}. Thank you! 🫙`);
    return `<tr>
      <td class="mono bold">${o.id}</td>
      <td>${typeB(o.type)}</td>
      <td><div class="bold">${o.cust}</div><div class="muted" style="font-size:11px">${o.ph}</div></td>
      <td>${pr?pr.name:'—'}<div class="muted" style="font-size:11px">${o.sz} × ${o.qty}</div></td>
      <td class="bold">${fmtC(o.total)}</td>
      <td>${statusB(o.status)}</td>
      <td>${payB(o.pay)}</td>
      <td>${fmtD(o.date)}</td>
      <td><div class="fr">
        ${ROLE==='admin'?`<button class="btn btn-ghost btn-xs" onclick="editOrder('${o.id}')">✏️</button>`:''}
        <button class="btn btn-ghost btn-xs" onclick="genInvoice('${o.id}')">🧾</button>
        <a href="https://wa.me/91${o.ph}?text=${waMsg}" target="_blank"><button class="btn btn-green btn-xs">💬</button></a>
        ${ROLE==='admin'?`<button class="btn btn-red btn-xs" onclick="delOrder('${o.id}')">🗑️</button>`:''}
      </div></td></tr>`;
  }).join('');

  return `
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:.8rem;margin-bottom:1rem">
    <div class="stat a" style="padding:.9rem"><div class="stat-lbl">Pending</div><div class="stat-val" style="font-size:24px">${sCounts.Pending}</div></div>
    <div class="stat b" style="padding:.9rem"><div class="stat-lbl">Processing</div><div class="stat-val" style="font-size:24px">${sCounts.Processing}</div></div>
    <div class="stat go" style="padding:.9rem"><div class="stat-lbl">Packed</div><div class="stat-val" style="font-size:24px">${sCounts.Packed}</div></div>
    <div class="stat g" style="padding:.9rem"><div class="stat-lbl">Delivered</div><div class="stat-val" style="font-size:24px">${sCounts.Delivered}</div></div>
  </div>
  <div class="card">
    <div class="card-hd">
      <div class="card-title">🛒 Orders (${list.length})</div>
      <div class="fr">
        <div class="sbox">🔍 <input id="ordQ" placeholder="Search ID / customer / phone..." value="${f}" oninput="reloadOrders()"></div>
        ${ROLE==='admin'?'<button class="btn btn-primary btn-sm" onclick="addOrderModal()">+ New Order</button>':''}
        <button class="btn btn-ghost btn-sm" onclick="showKanban()">📌 Kanban</button>
      </div>
    </div>
    <div class="fbar" style="padding:.5rem 1rem 0">
      <select id="ordTF" onchange="reloadOrders()"><option value="">All Types</option><option${tf==='Online'?' selected':''}>Online</option><option${tf==='Store'?' selected':''}>Store</option><option${tf==='Retail'?' selected':''}>Retail</option></select>
      <select id="ordSF" onchange="reloadOrders()"><option value="">All Status</option><option${sf==='Pending'?' selected':''}>Pending</option><option${sf==='Processing'?' selected':''}>Processing</option><option${sf==='Packed'?' selected':''}>Packed</option><option${sf==='Delivered'?' selected':''}>Delivered</option></select>
    </div>
    <div class="tbl-wrap"><table>
      <thead><tr><th>Order ID</th><th>Type</th><th>Customer</th><th>Product</th><th>Total</th><th>Status</th><th>Payment</th><th>Date</th><th>Actions</th></tr></thead>
      <tbody>${rows||`<tr><td colspan="9" class="tac muted" style="padding:2rem">No orders found</td></tr>`}</tbody>
    </table></div>
  </div>`;
}
function reloadOrders() {
  const q  = document.getElementById('ordQ')?.value||'';
  const tf = document.getElementById('ordTF')?.value||'';
  const sf = document.getElementById('ordSF')?.value||'';
  document.getElementById('pgContent').innerHTML = pgOrders(q,tf,sf);
}
function addOrderModal() {
  modal('🛒 New Order', `
    <div class="form-grid">${fg('Customer Name','<input id="o_c" placeholder="Full name">')}${fg('Phone','<input id="o_ph" type="tel" placeholder="10-digit">')}</div>
    <div class="form-grid">${fg('Order Type','<select id="o_t"><option>Online</option><option>Store</option><option>Retail</option></select>')}${fg('Product','<select id="o_p" onchange="calcT()">${prodOpts()}</select>')}</div>
    <div class="form-grid">${fg('Size','<select id="o_s" onchange="calcT()"><option>100ml</option><option>200ml</option><option>500ml</option><option>1L</option></select>')}${fg('Quantity','<input id="o_q" type="number" value="1" min="1" oninput="calcT()">')}</div>
    <div class="form-grid">${fg('Payment','<select id="o_pay"><option>Pending</option><option>Paid</option></select>')}${fg('Total (auto)','<input id="o_tot" readonly>')}</div>
    ${fg('Notes','<textarea id="o_n" placeholder="Special instructions..."></textarea>')}`,
    `<button class="btn btn-ghost" onclick="closeModal()">Cancel</button><button class="btn btn-primary" onclick="saveOrder()">✅ Place Order</button>`
  );
  calcT();
}
function calcT() {
  const p = byPid(document.getElementById('o_p')?.value);
  const s = document.getElementById('o_s')?.value;
  const q = parseInt(document.getElementById('o_q')?.value)||1;
  const el= document.getElementById('o_tot');
  if (p && s && el) el.value = fmtC((p.sizes[s]||0)*q);
}
function saveOrder() {
  const c  = document.getElementById('o_c').value.trim();
  const ph = document.getElementById('o_ph').value.trim();
  const pid= document.getElementById('o_p').value;
  const sz = document.getElementById('o_s').value;
  const qty= parseInt(document.getElementById('o_q').value)||1;
  const pay= document.getElementById('o_pay').value;
  const n  = document.getElementById('o_n').value;
  if (!c||!ph) { toast('Name and phone required','err'); return; }
  const p = byPid(pid);
  if (!p) { toast('Select a product','err'); return; }
  if ((p.stock[sz]||0) < qty) { toast(`Not enough stock! Only ${p.stock[sz]} ${sz} available`,'err'); return; }
  const total = (p.sizes[sz]||0)*qty;
  const ord = { id:gOrd(), type:document.getElementById('o_t').value, cust:c, ph, pid, sz, qty, total, status:'Pending', pay, date:today(), notes:n };
  ORDERS.push(ord);
  p.stock[sz] = Math.max(0,(p.stock[sz]||0)-qty);
  save(); buildNav(); closeModal(); go('orders');
  toast(`Order ${ord.id} placed!`,'ok');
}
function editOrder(id) {
  const o = ORDERS.find(x=>x.id===id); if(!o) return;
  modal('✏️ Edit Order — '+id, `
    <div class="form-grid">
      ${fg('Status',`<select id="eo_s"><option${o.status==='Pending'?' selected':''}>Pending</option><option${o.status==='Processing'?' selected':''}>Processing</option><option${o.status==='Packed'?' selected':''}>Packed</option><option${o.status==='Delivered'?' selected':''}>Delivered</option></select>`)}
      ${fg('Payment',`<select id="eo_p"><option${o.pay==='Pending'?' selected':''}>Pending</option><option${o.pay==='Paid'?' selected':''}>Paid</option></select>`)}
    </div>
    ${fg('Notes',`<textarea id="eo_n">${o.notes}</textarea>`)}`,
    `<button class="btn btn-ghost" onclick="closeModal()">Cancel</button><button class="btn btn-primary" onclick="saveEditOrder('${id}')">💾 Save</button>`
  );
}
function saveEditOrder(id) {
  const o = ORDERS.find(x=>x.id===id); if(!o) return;
  o.status = document.getElementById('eo_s').value;
  o.pay    = document.getElementById('eo_p').value;
  o.notes  = document.getElementById('eo_n').value;
  save(); buildNav(); closeModal(); go('orders'); toast('Order updated','ok');
}
function delOrder(id) {
  if (!confirm(`Delete order ${id}?`)) return;
  ORDERS = ORDERS.filter(o=>o.id!==id);
  save(); buildNav(); go('orders'); toast('Order deleted','warn');
}
function showKanban() {
  const statuses = ['Pending','Processing','Packed','Delivered'];
  const colors   = { Pending:'#D4760A',Processing:'#1A4F7A',Packed:'#C9960C',Delivered:'#1B6B3A' };
  const cols = statuses.map(st=>{
    const items = ORDERS.filter(o=>o.status===st);
    const cards = items.map(o=>{ const pr=byPid(o.pid); return `<div class="ki" onclick="editOrder('${o.id}')"><div class="ki-name">${o.cust}</div><div class="ki-sub">${o.id} · ${pr?pr.name:'?'} ${o.sz}</div><div class="fr" style="margin-top:4px">${typeB(o.type)}<span class="bold mla" style="font-size:11px">${fmtC(o.total)}</span></div></div>`; }).join('');
    return `<div class="kcol"><div class="kcol-hd">${st}<span class="kcount" style="background:${colors[st]}">${items.length}</span></div>${cards||'<div class="tac muted" style="padding:1rem;font-size:12px">Empty</div>'}</div>`;
  }).join('');
  modal('📌 Order Kanban Board',`<div class="kanban">${cols}</div>`,'<button class="btn btn-ghost" onclick="closeModal()">Close</button>','xl');
}

