  PAGE=p; setNav(p);
  document.getElementById('pgTitle').textContent = TITLES[p]||p;
  const c = document.getElementById('pgContent');
  const pages = { dashboard:pgDash, orders:pgOrders, inventory:pgInventory, batches:pgBatches, catalogue:pgCatalogue, workers:pgWorkers, vendors:pgVendors, invoices:pgInvoices, barcodes:pgBarcodes, export:pgExport, settings:pgSettings };
