  const monSales = monOrds.reduce((s,o)=>s+o.total,0);
  const low      = lowStkItems();

  // 7-day bar chart
  const days = Array.from({length:7},(_,i)=>{ const d=new Date(); d.setDate(d.getDate()-6+i); return d; });
  const maxV = Math.max(...days.map(d=>ORDERS.filter(o=>o.date===d.toISOString().split('T')[0]).reduce((s,o)=>s+o.total,0)),1);
  const bars = days.map(d=>{
    const ds = d.toISOString().split('T')[0];
    const v  = ORDERS.filter(o=>o.date===ds).reduce((s,o)=>s+o.total,0);
    const h  = Math.max(Math.round(v/maxV*80),3);
    const lbl= ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][d.getDay()];
    return `<div class="bar-col"><div class="bar-v">${v>0?fmtC(v):''}</div><div class="bar-b" style="height:${h}px" title="${fmtC(v)}"></div><div class="bar-lbl">${lbl}</div></div>`;
  }).join('');

  // Type dist
  const types = ['Online','Store','Retail'];
  const tc = {};  types.forEach(t=>tc[t]=ORDERS.filter(o=>o.type===t).length);
  const total = ORDERS.length||1;
  const typeProg = types.map(t=>{
    const pct = Math.round(tc[t]/total*100);
    return `<div style="margin-bottom:.7rem">
      <div class="fr" style="justify-content:space-between;margin-bottom:3px"><span style="font-size:12px;font-weight:600">${t}</span><span class="mono" style="font-size:11px">${tc[t]} (${pct}%)</span></div>
      <div class="prog"><div class="prog-fill" style="width:${pct}%"></div></div></div>`;
  }).join('');

  const lowHtml = low.length
    ? low.map(i=>`<div class="alert ${i.qty===0?'alert-danger':'alert-warn'}">${i.qty===0?'🔴':'🟡'} <b>${i.prod} (${i.sz})</b> — ${i.qty} units remaining</div>`).join('')
    : '<div class="alert alert-ok">✅ All stock levels are healthy</div>';

  const recentRows = [...ORDERS].slice(-5).reverse().map(o=>{
    const pr = byPid(o.pid);
    return `<tr><td class="mono bold">${o.id}</td><td>${o.cust}</td><td>${pr?pr.name:'—'}</td><td>${statusB(o.status)}</td><td class="bold">${fmtC(o.total)}</td><td>${payB(o.pay)}</td></tr>`;
  }).join('');

  return `
  <div class="stats-grid">
    <div class="stat a"><div class="stat-lbl">Today's Sales</div><div class="stat-val">${fmtC(todSales)}</div><div class="stat-sub">${tod.length} orders today</div><div class="stat-ico">💰</div></div>
    <div class="stat b"><div class="stat-lbl">Total Orders</div><div class="stat-val">${ORDERS.length}</div><div class="stat-sub">All time</div><div class="stat-ico">🛒</div></div>
    <div class="stat r"><div class="stat-lbl">Pending</div><div class="stat-val">${pending}</div><div class="stat-sub">Need attention</div><div class="stat-ico">⏳</div></div>
    <div class="stat g"><div class="stat-lbl">Revenue</div><div class="stat-val">${fmtC(allRev)}</div><div class="stat-sub">Total earned</div><div class="stat-ico">📈</div></div>
    <div class="stat go"><div class="stat-lbl">This Month</div><div class="stat-val">${fmtC(monSales)}</div><div class="stat-sub">${monOrds.length} orders</div><div class="stat-ico">📅</div></div>
    <div class="stat a"><div class="stat-lbl">Products</div><div class="stat-val">${PRODUCTS.length}</div><div class="stat-sub">Active products</div><div class="stat-ico">🫙</div></div>
  </div>
  <div style="display:grid;grid-template-columns:2fr 1fr;gap:1rem;margin-bottom:1rem">
    <div class="card"><div class="card-hd"><div class="card-title">📊 7-Day Sales</div></div><div class="card-bd"><div class="bar-chart">${bars}</div></div></div>
    <div class="card"><div class="card-hd"><div class="card-title">🛒 Order Mix</div></div><div class="card-bd">${typeProg}</div></div>
  </div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
    <div class="card"><div class="card-hd"><div class="card-title">⚠️ Stock Alerts</div><button class="btn btn-ghost btn-sm" onclick="go('inventory')">View All</button></div><div class="card-bd">${lowHtml}</div></div>
    <div class="card"><div class="card-hd"><div class="card-title">🕐 Recent Orders</div><button class="btn btn-ghost btn-sm" onclick="go('orders')">View All</button></div>
    <div class="tbl-wrap"><table><thead><tr><th>ID</th><th>Customer</th><th>Product</th><th>Status</th><th>Amount</th><th>Payment</th></tr></thead><tbody>${recentRows}</tbody></table></div></div>
  </div>`;
}

