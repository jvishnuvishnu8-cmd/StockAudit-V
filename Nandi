function buildNav() {
  let h = '';
  NAV_DEF.forEach(item => {
    if (item.sec) { h += `<div class="nav-sect">${item.sec}</div>`; return; }
    if (!item.roles.includes(ROLE)) return;
    const pending = item.badge ? ORDERS.filter(o=>o.status==='Pending').length : 0;
    h += `<div class="nav-i" id="nav_${item.p}" onclick="go('${item.p}')"><span class="ic">${item.ic}</span>${item.l}${pending>0?`<span class="nbadge">${pending}</span>`:''}</div>`;
  });
  document.getElementById('sbNav').innerHTML = h;
}
function setNav(p) {
  document.querySelectorAll('.nav-i').forEach(el=>el.classList.remove('act'));
  const el = document.getElementById('nav_'+p); if(el) el.classList.add('act');
}
