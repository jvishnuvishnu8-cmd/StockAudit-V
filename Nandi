<style>
/* ══════════════════════════════════════════
   NANDI OILS ERP — Design System
   Theme: Warm Earthy Industrial
   Palette: Deep Amber + Rich Brown + Cream
   Font: DM Serif Display + DM Sans
   ══════════════════════════════════════════ */
:root{
  --amber:#D4760A;--amber2:#B85F00;--amber-lt:#FFF4E5;--amber-glow:rgba(212,118,10,.18);
  --brown:#2C1A0E;--brown2:#5C3317;--brown3:#8B5A2B;
  --cream:#FDFAF5;--cream2:#F5EFE4;--cream3:#EDE4D3;
  --green:#1B6B3A;--green-lt:#E6F4EC;
  --red:#C0392B;--red-lt:#FCECEA;
  --blue:#1A4F7A;--blue-lt:#E8F1FA;
  --gold:#C9960C;--gold-lt:#FEF8E6;
  --border:rgba(44,26,14,.12);--border2:rgba(44,26,14,.06);
  --shadow:0 2px 12px rgba(44,26,14,.08);--shadow-md:0 6px 28px rgba(44,26,14,.12);--shadow-lg:0 16px 56px rgba(44,26,14,.18);
  --radius:10px;--radius-lg:16px;
  --sbw:252px;
  --font:'DM Sans',sans-serif;--serif:'DM Serif Display',serif;--mono:'JetBrains Mono',monospace;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:var(--font);background:var(--cream);color:var(--brown);font-size:14px;line-height:1.5;overflow-x:hidden;}
::-webkit-scrollbar{width:4px;height:4px;}
::-webkit-scrollbar-track{background:var(--cream2);}
::-webkit-scrollbar-thumb{background:var(--amber);border-radius:99px;}

/* ── LOGIN ── */
#loginWrap{
  min-height:100vh;display:flex;align-items:center;justify-content:center;
  background:var(--brown);
  background-image:
    radial-gradient(ellipse 80% 60% at 20% 80%,rgba(212,118,10,.25) 0%,transparent 60%),
    radial-gradient(ellipse 60% 50% at 80% 20%,rgba(92,51,23,.6) 0%,transparent 60%),
    url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  position:relative;
}
.lc{
  background:var(--cream);border-radius:20px;padding:2.5rem 2.2rem;
  width:420px;max-width:95vw;
  box-shadow:var(--shadow-lg),0 0 0 1px rgba(255,255,255,.06);
  animation:fadeUp .5s cubic-bezier(.22,1,.36,1);
}
@keyframes fadeUp{from{opacity:0;transform:translateY(24px);}to{opacity:1;transform:translateY(0);}}
.lc-logo{text-align:center;margin-bottom:2rem;}
.lc-logo-mark{
  width:72px;height:72px;margin:0 auto .9rem;
  background:linear-gradient(145deg,var(--amber),var(--amber2));
  border-radius:18px;display:flex;align-items:center;justify-content:center;font-size:34px;
  box-shadow:0 8px 28px var(--amber-glow);
}
.lc-logo h1{font-family:var(--serif);font-size:26px;color:var(--brown);letter-spacing:-.3px;}
.lc-logo p{font-size:11.5px;color:var(--brown3);margin-top:3px;font-weight:500;letter-spacing:.6px;text-transform:uppercase;}
.ltabs{display:flex;background:var(--cream2);border-radius:10px;padding:3px;gap:3px;margin-bottom:1.4rem;}
.ltab{flex:1;padding:9px;border:none;background:transparent;border-radius:7px;font-family:var(--font);font-size:13px;font-weight:600;color:var(--brown3);cursor:pointer;transition:all .2s;}
.ltab.on{background:linear-gradient(135deg,var(--amber),var(--amber2));color:#fff;box-shadow:0 2px 10px var(--amber-glow);}
.fg{margin-bottom:1rem;}
.fg label{display:block;font-size:11px;font-weight:700;color:var(--brown3);text-transform:uppercase;letter-spacing:.7px;margin-bottom:5px;}
.fg input,.fg select{
  width:100%;padding:11px 14px;
  border:1.5px solid var(--cream3);border-radius:9px;
  font-family:var(--font);font-size:14px;color:var(--brown);background:#fff;
  outline:none;transition:border .18s,box-shadow .18s;
}
.fg input:focus,.fg select:focus{border-color:var(--amber);box-shadow:0 0 0 3px var(--amber-glow);}
.btn-login{
  width:100%;padding:13px;margin-top:.3rem;
  background:linear-gradient(135deg,var(--amber),var(--amber2));
  color:#fff;border:none;border-radius:10px;
  font-family:var(--font);font-size:15px;font-weight:700;cursor:pointer;
  box-shadow:0 4px 18px var(--amber-glow);transition:all .2s;
}
.btn-login:hover{transform:translateY(-1px);box-shadow:0 8px 28px var(--amber-glow);}
.lerr{color:var(--red);font-size:12px;text-align:center;margin-top:.5rem;min-height:18px;font-weight:500;}
.ldemo{font-size:11px;text-align:center;color:var(--brown3);opacity:.6;margin-top:.7rem;}

/* ── APP ── */
#appWrap{display:none;min-height:100vh;background:var(--cream);}
.sidebar{
  width:var(--sbw);background:var(--brown);
  position:fixed;top:0;left:0;height:100vh;z-index:200;
  display:flex;flex-direction:column;overflow:hidden;
  transition:transform .28s cubic-bezier(.22,1,.36,1);
  box-shadow:4px 0 32px rgba(0,0,0,.18);
}
.sb-brand{
  padding:1.3rem 1.1rem 1rem;
  border-bottom:1px solid rgba(255,255,255,.07);
  display:flex;align-items:center;gap:10px;
}
.sb-icon{
  width:38px;height:38px;flex-shrink:0;
  background:linear-gradient(145deg,var(--amber),var(--amber2));
  border-radius:10px;display:flex;align-items:center;justify-content:center;
  font-size:19px;box-shadow:0 4px 14px var(--amber-glow);
}
.sb-title{font-family:var(--serif);font-size:16px;color:#fff;line-height:1.2;}
.sb-sub{font-size:10px;color:rgba(255,255,255,.35);letter-spacing:.4px;margin-top:1px;}
.sb-nav{flex:1;overflow-y:auto;padding:.5rem 0;}
.nav-sect{padding:.9rem 1.1rem .3rem;font-size:9.5px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:rgba(255,255,255,.2);}
.nav-i{
  display:flex;align-items:center;gap:10px;padding:9px 1.1rem;
  font-size:13px;font-weight:500;color:rgba(255,255,255,.55);
  cursor:pointer;border-left:2.5px solid transparent;transition:all .15s;
  position:relative;
}
.nav-i:hover{background:rgba(255,255,255,.05);color:rgba(255,255,255,.9);}
.nav-i.act{background:rgba(212,118,10,.18);border-left-color:var(--amber);color:#fff;font-weight:600;}
.nav-i .ic{width:18px;text-align:center;font-size:15px;flex-shrink:0;}
.nav-i .nbadge{margin-left:auto;background:var(--red);color:#fff;font-size:9px;padding:2px 6px;border-radius:99px;font-weight:700;}
.sb-foot{
  padding:.9rem 1.1rem;border-top:1px solid rgba(255,255,255,.07);
  display:flex;align-items:center;gap:9px;
}
.sb-av{width:34px;height:34px;border-radius:9px;background:var(--amber);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;color:#fff;flex-shrink:0;}
.sb-uname{font-size:12.5px;font-weight:600;color:#fff;line-height:1.3;}
.sb-urole{font-size:10px;color:rgba(255,255,255,.35);}
.sb-out{margin-left:auto;background:none;border:none;color:rgba(255,255,255,.35);cursor:pointer;font-size:17px;transition:color .2s;padding:4px;}
.sb-out:hover{color:var(--amber);}
.main{margin-left:var(--sbw);min-height:100vh;display:flex;flex-direction:column;}
.topbar{
  background:#fff;border-bottom:1px solid var(--border2);
  padding:.85rem 1.5rem;display:flex;align-items:center;justify-content:space-between;
  position:sticky;top:0;z-index:100;
  box-shadow:0 1px 0 var(--border2);
}
.topbar-l{display:flex;align-items:center;gap:10px;}
.topbar-title{font-family:var(--serif);font-size:19px;color:var(--brown);}
.topbar-r{display:flex;align-items:center;gap:8px;}
.topbar-date{font-size:12px;color:var(--brown3);font-weight:500;}
.fbbadge{font-size:10px;padding:4px 10px;border-radius:99px;background:var(--cream2);color:var(--brown3);border:1px solid var(--border);font-weight:600;}
.pc{padding:1.5rem;flex:1;}
.mob-btn{display:none;background:none;border:none;font-size:22px;cursor:pointer;color:var(--brown);padding:3px;}
.mob-ov{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:199;backdrop-filter:blur(2px);}
@media(max-width:900px){
  .main{margin-left:0;}
  .mob-btn{display:block;}
  .sidebar{transform:translateX(-100%);}
  .sidebar.open{transform:translateX(0);}
  .mob-ov.show{display:block;}
  .pc{padding:1rem;}
  .grid2{grid-template-columns:1fr!important;}
  .grid3{grid-template-columns:1fr 1fr!important;}
  .grid4{grid-template-columns:1fr 1fr!important;}
  .stats-grid{grid-template-columns:1fr 1fr!important;}
}

/* ── BUTTONS ── */
.btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border:none;border-radius:8px;font-family:var(--font);font-size:13px;font-weight:600;cursor:pointer;transition:all .18s;white-space:nowrap;text-decoration:none;}
.btn-primary{background:linear-gradient(135deg,var(--amber),var(--amber2));color:#fff;box-shadow:0 2px 10px var(--amber-glow);}
.btn-primary:hover{transform:translateY(-1px);box-shadow:0 6px 20px var(--amber-glow);}
.btn-ghost{background:var(--cream2);color:var(--brown);border:1px solid var(--border);}
.btn-ghost:hover{background:var(--cream3);}
.btn-green{background:var(--green);color:#fff;}
.btn-green:hover{background:#145c2f;}
.btn-red{background:var(--red);color:#fff;}
.btn-red:hover{background:#a93226;}
.btn-blue{background:var(--blue);color:#fff;}
.btn-gold{background:var(--gold);color:#fff;}
.btn-sm{padding:5px 11px;font-size:12px;border-radius:7px;}
.btn-xs{padding:3px 8px;font-size:11px;border-radius:6px;}

/* ── BADGES ── */
.badge{display:inline-block;padding:3px 9px;border-radius:99px;font-size:11px;font-weight:600;}
.bg-ok{background:var(--green-lt);color:var(--green);}
.bg-err{background:var(--red-lt);color:var(--red);}
.bg-warn{background:var(--gold-lt);color:var(--gold);}
.bg-info{background:var(--blue-lt);color:var(--blue);}
.bg-muted{background:var(--cream2);color:var(--brown3);}
.bg-amber{background:var(--amber-lt);color:var(--amber2);}

/* ── CARDS ── */
.card{background:#fff;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;margin-bottom:1rem;}
.card-hd{padding:.9rem 1.1rem;border-bottom:1px solid var(--border2);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;}
.card-title{font-size:14px;font-weight:700;color:var(--brown);display:flex;align-items:center;gap:7px;}
.card-bd{padding:1.1rem;}

/* ── STAT CARDS ── */
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:.9rem;margin-bottom:1.4rem;}
.stat{
  background:#fff;border:1px solid var(--border);border-radius:var(--radius);
  padding:1.1rem 1.2rem;position:relative;overflow:hidden;
  cursor:default;transition:transform .2s,box-shadow .2s;
}
.stat:hover{transform:translateY(-2px);box-shadow:var(--shadow-md);}
.stat::after{content:'';position:absolute;top:0;left:0;right:0;height:3px;border-radius:var(--radius) var(--radius) 0 0;}
.stat.a::after{background:linear-gradient(90deg,var(--amber),var(--amber2));}
.stat.g::after{background:linear-gradient(90deg,var(--green),#0f4425);}
.stat.r::after{background:linear-gradient(90deg,var(--red),#922b21);}
.stat.b::after{background:linear-gradient(90deg,var(--blue),#0e3558);}
.stat.go::after{background:linear-gradient(90deg,var(--gold),#8d6a09);}
.stat-lbl{font-size:10.5px;font-weight:700;color:var(--brown3);text-transform:uppercase;letter-spacing:.6px;}
.stat-val{font-family:var(--serif);font-size:30px;color:var(--brown);margin:4px 0 2px;line-height:1;}
.stat-sub{font-size:11px;color:var(--brown3);}
.stat-ico{position:absolute;right:1rem;top:50%;transform:translateY(-50%);font-size:38px;opacity:.08;}

/* ── TABLE ── */
.tbl-wrap{overflow-x:auto;}
table{width:100%;border-collapse:collapse;font-size:12.5px;}
thead th{background:var(--cream2);padding:9px 12px;text-align:left;font-weight:700;color:var(--brown3);font-size:11px;text-transform:uppercase;letter-spacing:.5px;white-space:nowrap;border-bottom:1px solid var(--border);}
tbody td{padding:9px 12px;border-bottom:1px solid var(--border2);white-space:nowrap;color:var(--brown);}
tbody tr:last-child td{border-bottom:none;}
tbody tr:hover td{background:#fdf8f1;}

/* ── FORM ── */
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;}
.form-grid.g3{grid-template-columns:1fr 1fr 1fr;}
.mfg{margin-bottom:.8rem;}
.mfg label{display:block;font-size:11px;font-weight:700;color:var(--brown3);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px;}
.mfg input,.mfg select,.mfg textarea{
  width:100%;padding:9px 12px;
  border:1.5px solid var(--cream3);border-radius:8px;
  font-family:var(--font);font-size:13px;color:var(--brown);background:#fff;
  outline:none;transition:border .18s,box-shadow .18s;
}
.mfg input:focus,.mfg select:focus,.mfg textarea:focus{border-color:var(--amber);box-shadow:0 0 0 3px var(--amber-glow);}
.mfg textarea{resize:vertical;min-height:72px;}
.mfg input[readonly]{background:var(--cream2);color:var(--brown3);}

/* ── MODAL ── */
.mov{position:fixed;inset:0;background:rgba(44,26,14,.55);z-index:500;display:flex;align-items:center;justify-content:center;padding:1rem;backdrop-filter:blur(3px);}
.mbox{background:#fff;border-radius:var(--radius-lg);width:560px;max-width:100%;max-height:92vh;overflow-y:auto;box-shadow:var(--shadow-lg);animation:fadeUp .22s cubic-bezier(.22,1,.36,1);}
.mbox.lg{width:820px;}
.mbox.xl{width:1050px;}
.mhd{padding:1.2rem 1.4rem;border-bottom:1px solid var(--border2);display:flex;align-items:center;justify-content:space-between;}
.mhd h3{font-family:var(--serif);font-size:18px;color:var(--brown);}
.mcls{background:none;border:none;font-size:20px;cursor:pointer;color:var(--brown3);line-height:1;padding:2px 5px;border-radius:5px;}
.mcls:hover{background:var(--red-lt);color:var(--red);}
.mbdy{padding:1.4rem;}
.mft{padding:1rem 1.4rem;border-top:1px solid var(--border2);display:flex;justify-content:flex-end;gap:8px;}

/* ── MISC ── */
.hidden{display:none!important;}
.fr{display:flex;align-items:center;flex-wrap:wrap;gap:8px;}
.mla{margin-left:auto;}
.mono{font-family:var(--mono);}
.bold{font-weight:700;}
.muted{color:var(--brown3);}
.tac{text-align:center;}
.tar{text-align:right;}
.w100{width:100%;}
.section-lbl{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:var(--brown3);margin:.9rem 0 .4rem;padding-top:.4rem;border-top:1px solid var(--border2);}
.alert{padding:.8rem 1rem;border-radius:8px;font-size:13px;font-weight:500;display:flex;align-items:center;gap:8px;margin-bottom:.6rem;}
.alert-warn{background:var(--gold-lt);color:var(--gold);border:1px solid rgba(201,150,12,.2);}
.alert-danger{background:var(--red-lt);color:var(--red);border:1px solid rgba(192,57,43,.2);}
.alert-ok{background:var(--green-lt);color:var(--green);border:1px solid rgba(27,107,58,.2);}
.prog{height:6px;background:var(--cream2);border-radius:99px;overflow:hidden;margin-top:5px;}
.prog-fill{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--amber),var(--amber2));transition:width .5s;}
.sbox{display:flex;align-items:center;gap:6px;background:var(--cream2);border:1px solid var(--border);border-radius:8px;padding:6px 11px;}
.sbox input{border:none;background:transparent;outline:none;font-family:var(--font);font-size:13px;color:var(--brown);width:180px;}
.fbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:.8rem;}
.fbar select{padding:6px 10px;border:1px solid var(--border);border-radius:7px;font-size:12px;background:#fff;font-family:var(--font);color:var(--brown);outline:none;}
.chip{display:inline-flex;align-items:center;gap:4px;padding:4px 11px;border-radius:99px;font-size:12px;font-weight:600;border:1.5px solid;cursor:pointer;transition:all .15s;}
.chip.on{background:var(--amber);color:#fff;border-color:var(--amber);}
.chip:not(.on){background:#fff;color:var(--brown3);border-color:var(--border);}
.stk-ok{display:inline-block;padding:2px 8px;border-radius:99px;font-size:10px;font-weight:700;font-family:var(--mono);background:var(--green-lt);color:var(--green);}
.stk-lo{display:inline-block;padding:2px 8px;border-radius:99px;font-size:10px;font-weight:700;font-family:var(--mono);background:var(--gold-lt);color:var(--gold);}
.stk-out{display:inline-block;padding:2px 8px;border-radius:99px;font-size:10px;font-weight:700;font-family:var(--mono);background:var(--red-lt);color:var(--red);}
.empty{text-align:center;padding:3rem 1rem;color:var(--brown3);}
.empty .ei{font-size:48px;opacity:.25;margin-bottom:.5rem;}

/* ── CHART ── */
.bar-chart{display:flex;align-items:flex-end;gap:5px;height:90px;margin-top:.6rem;}
.bar-col{display:flex;flex-direction:column;align-items:center;gap:3px;flex:1;}
.bar-b{width:100%;background:linear-gradient(180deg,var(--amber),var(--amber2));border-radius:4px 4px 0 0;min-height:3px;opacity:.8;transition:opacity .2s;}
.bar-b:hover{opacity:1;}
.bar-lbl,.bar-v{font-size:9px;color:var(--brown3);font-weight:600;}

/* ── KANBAN ── */
.kanban{display:grid;grid-template-columns:repeat(4,1fr);gap:.9rem;}
@media(max-width:700px){.kanban{grid-template-columns:1fr 1fr;}}
.kcol{background:var(--cream2);border-radius:10px;padding:.8rem;}
.kcol-hd{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--brown3);margin-bottom:.6rem;display:flex;align-items:center;justify-content:space-between;}
.kcount{width:19px;height:19px;border-radius:50%;font-size:10px;line-height:19px;text-align:center;color:#fff;font-weight:700;}
.ki{background:#fff;border-radius:8px;padding:.65rem .8rem;margin-bottom:.4rem;border:1px solid var(--border);font-size:12px;cursor:pointer;transition:all .18s;}
.ki:hover{box-shadow:var(--shadow);border-color:var(--amber);}
.ki-name{font-weight:700;color:var(--brown);}
.ki-sub{color:var(--brown3);font-size:11px;margin-top:2px;}

/* ── CATALOGUE ── */
.cat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem;}
.cat-card{background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;transition:transform .2s,box-shadow .2s;}
.cat-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-md);}
.cat-img{height:140px;background:linear-gradient(135deg,var(--amber-lt),var(--cream2));display:flex;align-items:center;justify-content:center;}
