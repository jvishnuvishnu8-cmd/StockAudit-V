function pgBatches() {
  const sorted = [...BATCHES].sort((a,b)=>new Date(a.mfg)-new Date(b.mfg));
  const rows = sorted.map(b=>{
    const p    = byPid(b.pid);
    const exp  = new Date(b.exp);
    const days = Math.ceil((exp-new Date())/(864e5));
    const cls  = days<30?'bg-err':days<90?'bg-warn':'bg-ok';
    const used = Math.round(((b.qty-b.rem)/b.qty)*100);
    return `<tr>
      <td class="mono" style="font-size:11px">${b.id}</td>
      <td>${p?p.emoji+' '+p.name:'—'}</td>
      <td><span class="badge bg-muted">${b.sz}</span></td>
      <td class="tac">${b.qty}</td>
      <td class="tac bold">${b.rem}</td>
      <td class="tac"><div style="display:flex;align-items:center;gap:6px"><div class="prog" style="width:70px;display:inline-block"><div class="prog-fill" style="width:${used}%"></div></div><span style="font-size:10px">${used}%</span></div></td>
      <td>${fmtD(b.mfg)}</td>
      <td><span class="badge ${cls}">${fmtD(b.exp)}</span></td>
      <td><span class="badge ${cls}">${days>0?days+' days':'EXPIRED'}</span></td>
      <td>${b.loc}</td>
      <td><div class="fr">
        <button class="btn btn-ghost btn-xs" onclick="batchBarcode('${b.id}')">🔳</button>
        <button class="btn btn-red btn-xs" onclick="delBatch('${b.id}')">🗑️</button>
      </div></td></tr>`;
  }).join('');
  return `
  <div class="fr" style="margin-bottom:1rem">
    <button class="btn btn-primary" onclick="addBatchModal()">+ New Batch</button>
    <span class="badge bg-info" style="font-size:12px">📋 FIFO Order Active — Oldest batches listed first</span>
