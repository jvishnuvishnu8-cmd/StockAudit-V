      <button class="btn btn-ghost btn-xs" style="margin-top:.5rem" onclick="doPrint()">🖨️</button>
    </div>`).join('');
  setTimeout(()=>{
    items.forEach(({p,sz,code})=>{
      const el = document.getElementById(`bc_${p.id}_${sz}`);
      if(el) try { JsBarcode(el,code,{format:'CODE128',width:1.5,height:45,displayValue:true,fontSize:10,margin:6}); } catch(e) {}
    });
  },200);
  return `
  <div style="margin-bottom:1rem"><div class="card-title" style="font-size:16px">🔳 Product Barcodes</div><div class="muted" style="font-size:12px;margin-top:4px">Auto-generated CODE128 barcodes for all products and sizes</div></div>
  <div class="bc-grid">${cards}</div>`;
}

// ══════════════════════════════════════════════
//  EXPORT
// ══════════════════════════════════════════════
function pgExport() {
  const card = (ico,t,d,fn) => `
    <div style="background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:1.3rem;text-align:center">
      <div style="font-size:36px;margin-bottom:.4rem">${ico}</div>
      <div class="bold" style="margin-bottom:.2rem">${t}</div>
      <div class="muted" style="font-size:12px;margin-bottom:.8rem">${d}</div>
      <button class="btn btn-primary btn-sm w100" onclick="${fn}()">⬇️ Export Excel</button>
    </div>`;
  return `
  <div class="card"><div class="card-hd"><div class="card-title">📤 Export Data to Excel</div></div>
  <div class="card-bd"><div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem">
    ${card('🛒','Orders','All order records','expOrders')}
    ${card('📦','Inventory','Stock levels','expInventory')}
    ${card('🏭','Batches','Batch register','expBatches')}
    ${card('👷','Workers','Worker list & payroll','expWorkers')}
    ${card('🏢','Vendors','Vendor directory','expVendors')}
    ${card('📋','Attendance','Daily attendance log','expAttendance')}
  </div></div></div>`;
}
function doExport(data,name) {
  if(!data.length){ toast('No data to export','warn'); return; }
  const wb=XLSX.utils.book_new(), ws=XLSX.utils.json_to_sheet(data);
  XLSX.utils.book_append_sheet(wb,ws,'Data');
  XLSX.writeFile(wb,name+'.xlsx');
  toast(name+' exported!','ok');
}
function expOrders()    { doExport(ORDERS.map(o=>({...o,productName:(byPid(o.pid)||{}).name||''})),'NandiOils_Orders_'+today()); }
function expInventory() { const d=[]; PRODUCTS.forEach(p=>(['100ml','200ml','500ml','1L'].forEach(sz=>d.push({product:p.name,size:sz,stock:p.stock[sz],price:p.sizes[sz],lowAlert:p.alert})))); doExport(d,'NandiOils_Inventory_'+today()); }
function expBatches()   { doExport(BATCHES.map(b=>({...b,productName:(byPid(b.pid)||{}).name||''})),'NandiOils_Batches_'+today()); }
function expWorkers()   { doExport(WORKERS,'NandiOils_Workers_'+today()); }
function expVendors()   { doExport(VENDORS,'NandiOils_Vendors_'+today()); }
function expAttendance(){ doExport(Object.entries(ATTENDANCE).map(([k,v])=>{ const [wid,d]=k.split('_'); return {workerId:wid,workerName:(byWid(wid)||{}).name||'',date:d,status:v}; }),'NandiOils_Attendance_'+today()); }

